# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NUNCA deve ir para o repositório.

# Chave da API do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Token do bot, obtido com o @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ID do chat que vai receber as mensagens.
# Para descobrir: mande /start para o seu bot e acesse
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# Opcional. Se ficar vazio, usa gemini-3.6-flash
GEMINI_MODEL=

# Opcional. Perfil de busca definido no dicionário PERFIS do script.
# Valores prontos: condominios, energia, saneamento, tecnologia, local, concorrencia
# Se ficar vazio, usa condominios
PERFIL_ATIVO=
